# Скопіюй у .env (локально) або задай як Environment Variables на Render.

# --- База даних (Supabase → кнопка "Connect" у шапці проєкту → Connection string) ---
# ВАЖЛИВО: бери "Shared pooler" / Transaction (порт 6543) — працює з Render по IPv4,
# платний IPv4 add-on НЕ потрібен.
DATABASE_URL=

# --- Telegram ---
# 1) У Telegram відкрий @BotFather → /newbot → отримаєш токен.
# 2) Свій chat_id найпростіше дізнатись у @userinfobot (написати йому /start).
#    Це ТВІЙ id (людини), а не id бота. Для групи менеджерів — id групи (з мінусом).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Google Calendar (дзеркало бронювань; ОПЦІЙНО — без цього все працює) ---
# Покроково як отримати — див. DEPLOY.md, крок 3.
# GOOGLE_CALENDAR_ID — id календаря (напр. xxxx@group.calendar.google.com або email)
# GOOGLE_SERVICE_ACCOUNT_JSON — вміст JSON-ключа сервісного акаунта ОДНИМ рядком
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- CORS: з яких сайтів дозволено запити (через кому) ---
ALLOWED_ORIGIN=https://kameneva-tn.github.io

PORT=3000

# Лише для локального Postgres без SSL (на Render/Supabase НЕ задавати):
# PGSSL=off
